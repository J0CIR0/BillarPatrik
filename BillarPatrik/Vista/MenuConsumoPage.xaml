<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BillarPatrik.Vista.MenuConsumoPage"
             BackgroundColor="#111827"
             Title="Consumos">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Seleccione un producto"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#F8FAFC"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Cerrar"
                    Clicked="CerrarMenu"
                    BackgroundColor="#374151"
                    TextColor="#F8FAFC"
                    CornerRadius="10"
                    HeightRequest="40" />
        </Grid>

        <ScrollView Grid.Row="1" Orientation="Horizontal">
            <HorizontalStackLayout x:Name="categoriasLayout" Spacing="8" />
        </ScrollView>

        <CarouselView x:Name="productosCarousel"
                      Grid.Row="2"
                      PeekAreaInsets="40"
                      Loop="False">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="8"
                            Padding="14"
                            Stroke="#374151"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="#1F1F1F">
                        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
                            <Label Text="{Binding Categoria}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#22C55E"
                                   HorizontalTextAlignment="Center" />
                            <Image Grid.Row="1"
                                   Source="{Binding Imagen}"
                                   Aspect="AspectFit"
                                   HeightRequest="220" />
                            <VerticalStackLayout Grid.Row="2" Spacing="4">
                                <Label Text="{Binding Nombre}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#F8FAFC"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding PrecioTexto}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#22C55E"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <Button Grid.Row="3"
                                    Text="AGREGAR"
                                    BackgroundColor="#166534"
                                    TextColor="#F8FAFC"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="48"
                                    Clicked="AgregarProducto" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
    </Grid>
</ContentPage>
