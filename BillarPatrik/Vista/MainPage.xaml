<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BillarPatrik.Vista"
             x:Class="BillarPatrik.Vista.MainPage"
             BackgroundColor="#111827"
             Title="Panel de Trabajo">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:BoolToColorConverter x:Key="BoolToColorConverter" />
            <local:BoolToEstadoConverter x:Key="BoolToEstadoConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="rootGrid" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,1.35*" Padding="16" RowSpacing="12" ColumnSpacing="12">

        <Border x:Name="HeaderPanel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Stroke="#374151" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,10" BackgroundColor="#1F1F1F">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="BILLAR PATRIK" FontSize="20" FontAttributes="Bold" TextColor="#F8FAFC" />
                    <Label x:Name="lblTrabajador" Text="Trabajador: [Nombre]" FontSize="12" TextColor="#9CA3AF" />
                </VerticalStackLayout>

                <Border Grid.Column="2" Stroke="#14532D" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="16,8" BackgroundColor="#17382A" VerticalOptions="Center">
                    <VerticalStackLayout>
                        <Label Text="RECAUDACIÓN" FontSize="10" TextColor="#9CA3AF" HorizontalTextAlignment="Center" />
                        <Label x:Name="lblRecaudacion" Text="0.00 Bs" FontSize="20" FontAttributes="Bold" TextColor="#22C55E" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="MesaPanel" Grid.Row="1" Grid.Column="0" Stroke="#374151" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12" BackgroundColor="#1F1F1F">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <Label Text="MESAS" FontSize="15" FontAttributes="Bold" TextColor="#22C55E" />
                <CollectionView x:Name="cvMesas" Grid.Row="1" SelectionMode="Single" SelectionChanged="SeleccionarMesa">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout x:Name="layoutMesas" Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#374151" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="10" HeightRequest="125" BackgroundColor="{Binding Ocupada, Converter={StaticResource BoolToColorConverter}}">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="6">
                                    <Border WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 21" Stroke="#4B5563" StrokeThickness="1" BackgroundColor="#292929" HorizontalOptions="Center">
                                        <Label Text="{Binding NumeroMesa}" FontSize="16" FontAttributes="Bold" TextColor="#F8FAFC" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label Text="{Binding Ocupada, Converter={StaticResource BoolToEstadoConverter}}" FontSize="11" FontAttributes="Bold" TextColor="#22C55E" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <Border x:Name="DetailPanel" Grid.Row="1" Grid.Column="1" Stroke="#374151" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16" BackgroundColor="#1F1F1F">
            <ScrollView>
                <VerticalStackLayout Spacing="12">
                    <Label Text="DETALLE DE LA MESA" FontSize="16" FontAttributes="Bold" TextColor="#F8FAFC" HorizontalTextAlignment="Center" />

                    <Label x:Name="lblDetalleMesa" Text="Seleccione una mesa para ver su detalle." FontSize="13" TextColor="#9CA3AF" HorizontalTextAlignment="Center" Margin="0,16,0,0" />

                    <VerticalStackLayout x:Name="stackDetalle" IsVisible="False" Spacing="12">
                        <Border Stroke="#374151" StrokeShape="RoundRectangle 10" Padding="12" BackgroundColor="#292929">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="Cliente" TextColor="#9CA3AF" FontAttributes="Bold" />
                                <Label x:Name="lblClienteDetalle" Grid.Column="1" TextColor="#F8FAFC" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                        <Border Stroke="#374151" StrokeShape="RoundRectangle 10" Padding="12" BackgroundColor="#292929">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="Tiempo" TextColor="#9CA3AF" FontAttributes="Bold" />
                                <Label x:Name="lblTiempoDetalle" Grid.Column="1" TextColor="#F8FAFC" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                        <Border Stroke="#374151" StrokeShape="RoundRectangle 10" Padding="12" BackgroundColor="#292929">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="Consumo" TextColor="#9CA3AF" FontAttributes="Bold" />
                                <Label x:Name="lblConsumoDetalle" Grid.Column="1" TextColor="#22C55E" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Button x:Name="btnAgregarConsumoDetalle" Text="AGREGAR CONSUMO" Clicked="AgregarConsumoDetalle" BackgroundColor="#166534" TextColor="#F8FAFC" CornerRadius="10" HeightRequest="48" IsVisible="False" />
                    <Button x:Name="btnCobrarDetalle" Text="COBRAR MESA" Clicked="CobrarMesaDetalle" BackgroundColor="#14532D" TextColor="#F8FAFC" CornerRadius="10" HeightRequest="48" IsVisible="False" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <Grid x:Name="footerGrid" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button x:Name="btnCerrarTurno" Text="CERRAR CAJA" Clicked="CerrarTurno" BackgroundColor="#B91C1C" TextColor="#F8FAFC" FontAttributes="Bold" CornerRadius="10" HeightRequest="48" />
            <Button Grid.Column="1" Text="CERRAR SESIÓN" Clicked="CerrarSesion" BackgroundColor="#374151" TextColor="#F8FAFC" CornerRadius="10" HeightRequest="48" />
        </Grid>
    </Grid>
</ContentPage>