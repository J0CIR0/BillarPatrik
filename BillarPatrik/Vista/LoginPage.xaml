<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BillarPatrik.Vista.LoginPage"
             BackgroundColor="#111827"
             Shell.NavBarIsVisible="False">

    <Grid Padding="24">
        <Border x:Name="LoginCard"
                MaximumWidthRequest="420"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Padding="32"
                Stroke="#374151"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                BackgroundColor="#1F1F1F">
            <VerticalStackLayout Spacing="18">
                <Border HeightRequest="76"
                        WidthRequest="76"
                        StrokeShape="RoundRectangle 38"
                        BackgroundColor="#14532D"
                        Stroke="#22C55E"
                        StrokeThickness="2"
                        HorizontalOptions="Center">
                    <Label Text="BP" FontSize="26" FontAttributes="Bold" TextColor="#F8FAFC"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>

                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="BILLAR PATRIK" FontSize="30" FontAttributes="Bold" TextColor="#F8FAFC" HorizontalTextAlignment="Center" />
                    <Label Text="Sistema de gestión" FontSize="14" TextColor="#9CA3AF" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" Margin="0,12,0,0">
                    <Entry x:Name="txtUsuario"
                           Placeholder="Usuario"
                           TextColor="#F8FAFC"
                           PlaceholderColor="#9CA3AF"
                           BackgroundColor="#292929"
                           HeightRequest="52" />
                    <Entry x:Name="txtContrasena"
                           Placeholder="Contraseña"
                           IsPassword="True"
                           TextColor="#F8FAFC"
                           PlaceholderColor="#9CA3AF"
                           BackgroundColor="#292929"
                           HeightRequest="52" />
                </VerticalStackLayout>

                <Button x:Name="btnIngresar"
                        Text="INGRESAR"
                        Clicked="Ingresar"
                        BackgroundColor="#166534"
                        TextColor="#F8FAFC"
                        FontAttributes="Bold"
                        HeightRequest="52"
                        CornerRadius="10"
                        Margin="0,6,0,0" />

                <Label x:Name="lblError"
                       TextColor="#F87171"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       IsVisible="False" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>