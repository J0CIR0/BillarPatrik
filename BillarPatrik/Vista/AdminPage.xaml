<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BillarPatrik.Vista.AdminPage"
             BackgroundColor="#111827"
             Title="Panel de Administrador">

    <Grid Padding="24">
        <Border MaximumWidthRequest="620"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Stroke="#374151"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="28"
                BackgroundColor="#1F1F1F">
            <VerticalStackLayout Spacing="18">
                <Border HeightRequest="64" WidthRequest="64" StrokeShape="RoundRectangle 32" Stroke="#22C55E" StrokeThickness="2" BackgroundColor="#14532D" HorizontalOptions="Center">
                    <Label Text="A" FontSize="24" FontAttributes="Bold" TextColor="#F8FAFC" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>

                <Label x:Name="lblBienvenida"
                       Text="Bienvenido, Administrador"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="#F8FAFC" />

                <Border Stroke="#374151" StrokeShape="RoundRectangle 12" Padding="18" BackgroundColor="#292929">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="PANEL ADMINISTRATIVO" FontSize="12" FontAttributes="Bold" TextColor="#22C55E" HorizontalTextAlignment="Center" />
                        <Label Text="Módulos de gestión disponibles próximamente" FontSize="14" TextColor="#9CA3AF" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="CERRAR SESIÓN"
                        Clicked="CerrarSesion"
                        BackgroundColor="#374151"
                        TextColor="#F8FAFC"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="48" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>